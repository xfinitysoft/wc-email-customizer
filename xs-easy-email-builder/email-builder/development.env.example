# Copy to .env.development.local (same folder as package.json) and restart npm start.

VITE_WP_ORIGIN=http://localhost/tester

# Required for npm start: REST needs an Administrator (manage_options).
# Users → Profile → Application Passwords → create one.
# VITE_WP_APPLICATION_USER = WordPress *username* (login), not email.
VITE_WP_APPLICATION_USER=
VITE_WP_APPLICATION_PASSWORD=

# Optional (usually not enough alone without cookies on port 5173):
VITE_WP_REST_NONCE=
